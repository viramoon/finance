{
  "$defs": {
    "DelayTier": {
      "enum": [
        "realtime",
        "delayed",
        "replay"
      ],
      "type": "string"
    },
    "MarketKind": {
      "description": "Market data kinds a source/product can advertise in version 2.0.",
      "enum": [
        "bar_closed",
        "trade",
        "snapshot",
        "delta",
        "perpetual_context"
      ],
      "type": "string"
    },
    "SchemaVersion": {
      "enum": [
        "2.0"
      ],
      "type": "string"
    },
    "Token": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "urn:viramoon:finance:market-protocol:2.0:capability",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Advertised market data capability of a source/product pair.",
  "properties": {
    "can_backfill": {
      "type": "boolean"
    },
    "delay_tier": {
      "$ref": "#/$defs/DelayTier"
    },
    "max_depth": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "message_kinds": {
      "contains": {
        "const": "perpetual_context"
      },
      "items": {
        "$ref": "#/$defs/MarketKind"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "product": {
      "$ref": "#/$defs/Token"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "source": {
      "$ref": "#/$defs/Token"
    }
  },
  "required": [
    "schema_version",
    "source",
    "product",
    "message_kinds",
    "max_depth",
    "can_backfill",
    "delay_tier"
  ],
  "type": "object"
}
