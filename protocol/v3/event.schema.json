{
  "$defs": {
    "DecimalText": {
      "pattern": "^(?=-?(?:[0-9][.]?){1,28}(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])",
      "type": "string"
    },
    "InstrumentId": {
      "pattern": "^(?=[A-Z0-9_.-]{1,96}\\.[A-Z0-9][A-Z0-9_-]{0,31}(?![\\s\\S]))[A-Z0-9][A-Z0-9_-]*(?:\\.[A-Z0-9][A-Z0-9_-]*)*\\.[A-Z0-9][A-Z0-9_-]{0,31}(?![\\s\\S])",
      "type": "string"
    },
    "Message": {
      "description": "The event kind tag and its corresponding payload.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "option_history_trade"
              ],
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/OptionHistoryTrade"
            }
          },
          "required": [
            "payload",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "option_history_quote"
              ],
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/OptionHistoryQuote"
            }
          },
          "required": [
            "payload",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "NonEmptyText": {
      "minLength": 1,
      "type": "string"
    },
    "OptionHistoryBatch": {
      "additionalProperties": false,
      "description": "The request and the occurrence within a complete source second.",
      "properties": {
        "occurrence": {
          "$ref": "#/$defs/U64Text"
        },
        "page": {
          "$ref": "#/$defs/U64Text"
        },
        "request_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)(?![\\s\\S])",
              "type": "string"
            }
          ]
        },
        "requested_start_ts": {
          "$ref": "#/$defs/U64Text"
        }
      },
      "required": [
        "requested_start_ts",
        "page",
        "occurrence",
        "request_id"
      ],
      "type": "object"
    },
    "OptionHistoryQuote": {
      "additionalProperties": false,
      "description": "Raw historical top-of-book evidence. Unavailable fields remain null.",
      "properties": {
        "ask": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^(?=-?(?:[0-9][.]?){1,28}(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])",
              "type": "string"
            }
          ]
        },
        "ask_past_high": {
          "type": "boolean"
        },
        "ask_quantity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^(?=-?(?:[0-9][.]?){1,28}(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])",
              "type": "string"
            }
          ]
        },
        "batch": {
          "$ref": "#/$defs/OptionHistoryBatch"
        },
        "bid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^(?=-?(?:[0-9][.]?){1,28}(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])",
              "type": "string"
            }
          ]
        },
        "bid_past_low": {
          "type": "boolean"
        },
        "bid_quantity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^(?=-?(?:[0-9][.]?){1,28}(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "batch",
        "bid",
        "ask",
        "bid_quantity",
        "ask_quantity",
        "bid_past_low",
        "ask_past_high"
      ],
      "type": "object"
    },
    "OptionHistoryTrade": {
      "additionalProperties": false,
      "description": "Raw option trade callback evidence, including unmapped or empty condition codes.",
      "properties": {
        "batch": {
          "$ref": "#/$defs/OptionHistoryBatch"
        },
        "condition_mapping_version": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "contract_multiplier": {
          "$ref": "#/$defs/DecimalText"
        },
        "exchange": {
          "type": "string"
        },
        "past_limit": {
          "type": "boolean"
        },
        "price": {
          "$ref": "#/$defs/DecimalText"
        },
        "quantity": {
          "$ref": "#/$defs/DecimalText"
        },
        "special_conditions": {
          "type": "string"
        },
        "unreported": {
          "type": "boolean"
        }
      },
      "required": [
        "batch",
        "price",
        "quantity",
        "contract_multiplier",
        "exchange",
        "special_conditions",
        "condition_mapping_version",
        "past_limit",
        "unreported"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "enum": [
        "3.0"
      ],
      "type": "string"
    },
    "Token": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}(?![\\s\\S])",
      "type": "string"
    },
    "U64Text": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)(?![\\s\\S])",
      "type": "string"
    },
    "Venue": {
      "pattern": "^[A-Z0-9][A-Z0-9_-]{0,31}(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "urn:viramoon:finance:market-protocol:3.0:event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "#/$defs/Message"
    },
    {
      "properties": {
        "asset_kind": {
          "const": "option"
        },
        "channel": {
          "$ref": "#/$defs/Token"
        },
        "cursor": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "epoch": {
          "$ref": "#/$defs/U64Text"
        },
        "exchange_ts": {
          "$ref": "#/$defs/U64Text"
        },
        "first_available_ts": {
          "$ref": "#/$defs/U64Text"
        },
        "instrument_id": {
          "$ref": "#/$defs/InstrumentId"
        },
        "license": {
          "$ref": "#/$defs/Token"
        },
        "native_id": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "product": {
          "$ref": "#/$defs/Token"
        },
        "receive_ts": {
          "$ref": "#/$defs/U64Text"
        },
        "revision": {
          "const": "0"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "seq": {
          "$ref": "#/$defs/U64Text"
        },
        "source": {
          "$ref": "#/$defs/Token"
        },
        "venue": {
          "$ref": "#/$defs/Venue"
        }
      },
      "required": [
        "schema_version",
        "channel",
        "source",
        "product",
        "instrument_id",
        "asset_kind",
        "venue",
        "exchange_ts",
        "receive_ts",
        "first_available_ts",
        "epoch",
        "seq",
        "cursor",
        "revision",
        "license"
      ],
      "type": "object"
    }
  ],
  "description": "One event and its position in an instrument stream.",
  "unevaluatedProperties": false
}
